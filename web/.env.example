# ─── Database (Supabase) ──────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database
# Use "Transaction" pooler URL for DATABASE_URL (port 6543)
# Use "Direct" connection URL for DIRECT_URL (port 5432)
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.XXXX:PASSWORD@db.XXXX.supabase.co:5432/postgres

# ─── Stellar Network ──────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# NEXT_PUBLIC_ variants required for client-side code (soroban.ts / launch page)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ─── Stellar Operator (Server-side signing) ──────────────
# Generates: stellar keys generate operator --network testnet
# View secret: stellar keys show operator
STELLAR_OPERATOR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Operator treasury public key (used for server-side authorization checks)
STELLAR_OPERATOR_PUBLIC_KEY=GCEFRNTKTNYOS7QFQ7USU57N3NZZA65FXAVGA2WKFYJGKQZSM5WNAKRL

# Operator treasury public key (client-side variant exposed to the browser frontend)
NEXT_PUBLIC_STELLAR_OPERATOR_PUBLIC_KEY=GCEFRNTKTNYOS7QFQ7USU57N3NZZA65FXAVGA2WKFYJGKQZSM5WNAKRL

# ─── Soroban Smart Contracts ─────────────────────────────
# Run: cd contracts && ./deploy.sh testnet (returns contract IDs)
NEXT_PUBLIC_TALOS_REGISTRY_CONTRACT=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_TALOS_NAME_SERVICE_CONTRACT=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Wallet Connection (Stellar) ─────────────────────────
NEXT_PUBLIC_STELLAR_WALLET_NETWORK=testnet

# ─── x402 on Stellar ─────────────────────────────────────
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_API_KEY=
X402_SETTLEMENT_NETWORK=stellar-testnet

# ─── AI Services ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
TAVILY_API_KEY=tvly-...

# ─── Talos Genesis ────────────────────────────────────────
NEXT_PUBLIC_TALOS_CREATION_XLM=20

# ─── Observability ────────────────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=info

# ─── Transactional Outbox (see web/OUTBOX.md) ────────────
# Master switch. Defaults to false.
OUTBOX_ENABLED=false

# Bearer token for GET/POST /api/admin/outbox/* (inspect, retry). Shared
# with the jobs framework's admin routes if both are deployed.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Shared secret for POST /api/internal/outbox/drain (scheduler trigger).
OUTBOX_DISPATCH_SECRET=replace-with-a-long-random-secret

# Optional tuning — sane defaults apply if unset. See web/OUTBOX.md.
# OUTBOX_LEASE_DURATION_MS=15000
# OUTBOX_BATCH_SIZE=25
# OUTBOX_DEFAULT_MAX_ATTEMPTS=8
# OUTBOX_POLL_INTERVAL_MS=2000
# OUTBOX_RETENTION_DAYS=7